<Project>

	<!-- Single source of truth for the mod's version. Reads the Version/Channel
	     consts out of Quartz/Core/Info.cs and the build counter out of build.json
	     (which tools/release.sh bumps), and exposes them as properties.

	     Evaluated at project-evaluation time, not inside a target, so
	     AssemblyVersion/FileVersion can be derived from it too. Import this before
	     any PropertyGroup that consumes $(QuartzVersion). -->

	<PropertyGroup>
		<_QuartzInfoPath>$(MSBuildThisFileDirectory)../Quartz/Core/Info.cs</_QuartzInfoPath>
		<_QuartzBuildsPath>$(MSBuildThisFileDirectory)../build.json</_QuartzBuildsPath>

		<_QuartzInfoText Condition="Exists('$(_QuartzInfoPath)')">$([System.IO.File]::ReadAllText('$(_QuartzInfoPath)'))</_QuartzInfoText>
		<QuartzVersion>$([System.Text.RegularExpressions.Regex]::Match($(_QuartzInfoText), '\bVersion\s*=\s*"([^"]+)"').Groups[1].Value)</QuartzVersion>
		<QuartzChannel>$([System.Text.RegularExpressions.Regex]::Match($(_QuartzInfoText), '\bChannel\s*=\s*"([^"]+)"').Groups[1].Value)</QuartzChannel>

		<_QuartzBuildsText Condition="Exists('$(_QuartzBuildsPath)')">$([System.IO.File]::ReadAllText('$(_QuartzBuildsPath)'))</_QuartzBuildsText>
		<_QuartzVerEsc>$([System.Text.RegularExpressions.Regex]::Escape($(QuartzVersion)))</_QuartzVerEsc>
		<_QuartzBuildPattern>"$(_QuartzVerEsc)"\s*:\s*\{[^}]*?"$(QuartzChannel)"\s*:\s*(\d+)</_QuartzBuildPattern>
		<QuartzBuild>$([System.Text.RegularExpressions.Regex]::Match('$(_QuartzBuildsText)', '$(_QuartzBuildPattern)').Groups[1].Value)</QuartzBuild>
		<QuartzBuild Condition="'$(QuartzBuild)' == ''">0</QuartzBuild>

		<!-- Stable drops the channel + build; pre-release mirrors Info.DisplayVersion. -->
		<QuartzDisplayVersion Condition="'$(QuartzChannel)' == 'stable'">$(QuartzVersion)</QuartzDisplayVersion>
		<QuartzDisplayVersion Condition="'$(QuartzDisplayVersion)' == ''">$(QuartzVersion)-$(QuartzChannel)-$(QuartzBuild)</QuartzDisplayVersion>

		<!-- Assembly identity deliberately ignores the build counter: bumping it must
		     not rebind every precompiled addon and module against a new identity. -->
		<QuartzAssemblyVersion Condition="'$(QuartzVersion)' != ''">$(QuartzVersion).0</QuartzAssemblyVersion>

		<!-- Module ABI, read from the same Info.cs the runtime gate uses. -->
		<QuartzModuleAbi>$([System.Text.RegularExpressions.Regex]::Match($(_QuartzInfoText), '\bModuleAbi\s*=\s*(\d+)').Groups[1].Value)</QuartzModuleAbi>
		<QuartzModuleAbi Condition="'$(QuartzModuleAbi)' == ''">1</QuartzModuleAbi>
	</PropertyGroup>

</Project>
