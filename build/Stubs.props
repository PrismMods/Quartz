<!--
  Stubs.props — redirect the game references at stubs/bin.

  Imported by Quartz.csproj and sdk/QuartzAddon.props (so the mod, the modules and
  the addon SDK all honour it). With -p:UseStubs=true every HintPath that pointed
  into a game install resolves out of stubs/ instead, which is how CI compiles all
  494 source files on a machine that has never seen the game.

  Nothing here changes what ships. The stub assemblies carry no method bodies, are
  never packaged, and are never loaded at runtime — a build made against them is a
  compile check, not a release artifact. Guard release paths on UseStubs != true.

  Import this AFTER ManagedDir/HarmonyDll are set and BEFORE the ItemGroups that
  use them: MSBuild evaluates in document order, so an import placed lower would
  redirect nothing.
-->
<Project>

  <PropertyGroup Condition="'$(UseStubs)' == 'true'">
    <QuartzStubBin>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../stubs/bin'))</QuartzStubBin>
    <!-- Every game reference funnels through one of these three. -->
    <ManagedDir>$(QuartzStubBin.TrimEnd('/').TrimEnd('\'))</ManagedDir>
    <LibDir>$(ManagedDir)</LibDir>
    <HarmonyDll>$(ManagedDir)/0Harmony.dll</HarmonyDll>
    <!-- A stub build is not installable and not a release. -->
    <AutoInstall>false</AutoInstall>
    <DeployToGame>false</DeployToGame>
    <QuartzSkipPackaging>true</QuartzSkipPackaging>
  </PropertyGroup>

  <Target Name="_QuartzCheckStubs" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseStubs)' == 'true'">
    <Error Condition="!Exists('$(ManagedDir)/Assembly-CSharp.dll')"
           Text="UseStubs=true but stubs/bin is empty. Build them first: dotnet build stubs/Stubs.proj -c $(Configuration)" />
  </Target>

</Project>
