<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="$(MSBuildProjectDirectory)/../build/Version.targets" />
	<Import Project="$(MSBuildProjectDirectory)/../build/Axis.props" />

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>warnings</Nullable>
		<RootNamespace>Quartz.Bootstrap</RootNamespace>
		<AssemblyName>$(QuartzBootstrapName)</AssemblyName>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>$(QuartzAssemblyVersion)</AssemblyVersion>
		<FileVersion>$(QuartzAssemblyVersion)</FileVersion>
		<InformationalVersion>$(QuartzDisplayVersion)</InformationalVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>NU1701;NU1702;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<IntermediateOutputPath>obj/$(QuartzAxis)/$(Configuration)/</IntermediateOutputPath>
		<OutputPath>bin/$(QuartzAxis)/$(Configuration)/</OutputPath>
		<ManagedDir>$(GamePath)/$(GameData)/Managed</ManagedDir>
		<LibDir Condition="'$(LibDir)' == ''">$(MSBuildProjectDirectory)/../lib</LibDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(LoaderTarget)' == 'UMM'">
		<DefineConstants>$(DefineConstants);QUARTZ_UMM</DefineConstants>
	</PropertyGroup>

	<Import Project="$(MSBuildProjectDirectory)/../build/Stubs.props" />

	<ItemDefinitionGroup>
		<Reference>
			<Private>false</Private>
			<ExternallyResolved>true</ExternallyResolved>
		</Reference>
	</ItemDefinitionGroup>

	<ItemGroup>
		<Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath></Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(LoaderTarget)' != 'UMM'">
		<Reference Include="MelonLoader"><HintPath>$(GamePath)/MelonLoader/net35/MelonLoader.dll</HintPath></Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(LoaderTarget)' == 'UMM'">
		<Reference Include="UnityModManager"><HintPath>$(ManagedDir)/UnityModManager/UnityModManager.dll</HintPath></Reference>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="../Quartz/Core/SemVer.cs" Link="Source/SemVer.cs" />
	</ItemGroup>

	<Target Name="AddLibSearchPath" BeforeTargets="ResolveAssemblyReferences">
		<PropertyGroup>
			<AssemblySearchPaths>$(AssemblySearchPaths);$(LibDir)</AssemblySearchPaths>
		</PropertyGroup>
	</Target>

	<!-- MelonInfo needs compile-time constants, so identity and version are baked
	     the same way the engine bakes its own. The version here is only what the
	     loader UI shows before the real runtime is resolved. -->
	<Target Name="GenerateBootstrapInfo" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_QuartzAuthor>$([System.Text.RegularExpressions.Regex]::Match($(_QuartzInfoText), '\bAuthor\s*=\s*"([^"]+)"').Groups[1].Value)</_QuartzAuthor>
			<_QuartzGithubLink>$([System.Text.RegularExpressions.Regex]::Match($(_QuartzInfoText), '\bGithubLink\s*=\s*"([^"]+)"').Groups[1].Value)</_QuartzGithubLink>
			<_BootstrapInfoFile>$(IntermediateOutputPath)BootstrapInfo.g.cs</_BootstrapInfoFile>
			<_BootstrapInfoBody>namespace Quartz.Bootstrap { internal static class BootstrapInfo { public const string ModName = "$(QuartzModName)"%3B public const string Version = "$(QuartzDisplayVersion)"%3B public const string Author = "$(_QuartzAuthor)"%3B public const string GithubLink = "$(_QuartzGithubLink)"%3B public const string PayloadFileName = "$(QuartzPayloadName).dll"%3B public const string EngineFileName = "$(QuartzEngineName).dll"%3B } }</_BootstrapInfoBody>
		</PropertyGroup>
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<WriteLinesToFile File="$(_BootstrapInfoFile)" Lines="$(_BootstrapInfoBody)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(_BootstrapInfoFile)" />
		</ItemGroup>
	</Target>

</Project>
