<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Must match the mod (Quartz.csproj / QuartzModule.props), NOT be stricter.
		     Every Compile item below is a linked mod source; compiling it under a
		     different nullable context than it ships under means the tests verify a
		     different compilation than the one users run. This was 'enable' and the
		     resulting ~90 nullable diagnostics went unread until the warning gate
		     turned them into errors. -->
		<Nullable>warnings</Nullable>
		<LangVersion>latest</LangVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<!-- Same gate as the mod (see Quartz.csproj). This project is what CI
		     actually compiles, so it is the one place the gate runs on every PR. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>NU1701;NU1702;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../Quartz/Core/SemVer.cs" Link="Source/SemVer.cs" />
