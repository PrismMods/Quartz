<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Must match the mod (Quartz.csproj / QuartzModule.props), NOT be stricter.
		     Every Compile item below is a linked mod source; compiling it under a
		     different nullable context than it ships under means the tests verify a
		     different compilation than the one users run. This was 'enable' and the
		     resulting ~90 nullable diagnostics went unread until the warning gate
		     turned them into errors. -->
		<Nullable>warnings</Nullable>
		<LangVersion>latest</LangVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<!-- Same gate as the mod (see Quartz.csproj). This project is what CI
		     actually compiles, so it is the one place the gate runs on every PR. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>NU1701;NU1702;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../Quartz/Core/SemVer.cs" Link="Source/SemVer.cs" />
		<!-- The late-binding layer. Refl.cs is deliberately free of game types so it
		     can be linked here; the one member that needs the game's assembly
		     (Type(string), which roots at ADOBase) lives in the Refl.Game.cs partial
		     and stays out of this project. -->
		<Compile Include="../Quartz/Core/Diag.cs" Link="Source/Diag.cs" />
		<Compile Include="../Quartz/Compat/Game/Refl.cs" Link="Source/Refl.cs" />
		<Compile Include="../Quartz/IO/AtomicFile.cs" Link="Source/AtomicFile.cs" />
		<Compile Include="../Quartz/IO/ProfileNames.cs" Link="Source/ProfileNames.cs" />
		<Compile Include="../Quartz/IO/ProfileBundle.cs" Link="Source/ProfileBundle.cs" />
		<Compile Include="../Quartz/IO/FaqDocument.cs" Link="Source/FaqDocument.cs" />
		<Compile Include="../modules/KeyViewer/KeyViewerCss.cs" Link="Source/KeyViewerCss.cs" />
		<Compile Include="../modules/KeyViewer/KeyViewerPersistence.cs" Link="Source/KeyViewerPersistence.cs" />
		<Compile Include="../modules/KeyViewer/Layout/KvElement.cs" Link="Source/KvElement.cs" />
		<Compile Include="../modules/KeyViewer/Layout/KvDocument.cs" Link="Source/KvDocument.cs" />
		<Compile Include="../modules/KeyViewer/Layout/KvExportShaping.cs" Link="Source/KvExportShaping.cs" />
		<Compile Include="../modules/KeyViewer/Layout/KvSnap.cs" Link="Source/KvSnap.cs" />
		<Compile Include="../modules/KeyViewer/Layout/KvHistory.cs" Link="Source/KvHistory.cs" />
		<Compile Include="../modules/Tuf/TufModels.cs" Link="Source/TufModels.cs" />
		<Compile Include="../modules/Tuf/TufSettings.cs" Link="Source/TufSettings.cs" />
		<Compile Include="../Quartz/IO/Interface/ISettingsFile.cs" Link="Source/ISettingsFile.cs" />
		<Compile Include="../modules/Tuf/TufApiQuery.cs" Link="Source/TufApiQuery.cs" />
		<Compile Include="../Quartz/Modules/ModuleManifest.cs" Link="Source/ModuleManifest.cs" />
		<Compile Include="../Quartz/Modules/ModuleState.cs" Link="Source/ModuleState.cs" />
		<Compile Include="../Quartz/Modules/ModuleOrder.cs" Link="Source/ModuleOrder.cs" />
		<Compile Include="../Quartz/Modules/ModuleMigration.cs" Link="Source/ModuleMigration.cs" />
		<Compile Include="../Quartz/Net/NetworkPolicy.cs" Link="Source/NetworkPolicy.cs" />
		<Compile Include="../modules/Tuf/TufNetworkPolicy.cs" Link="Source/TufNetworkPolicy.cs" />
		<Compile Include="../modules/Tuf/TufArchive.cs" Link="Source/TufArchive.cs" />
		<Compile Include="../modules/Tuf/TufDiskSpace.cs" Link="Source/TufDiskSpace.cs" />
		<Compile Include="../modules/Tuf/TufInstallPaths.cs" Link="Source/TufInstallPaths.cs" />
		<Compile Include="../modules/Tuf/TufInstallIndex.cs" Link="Source/TufInstallIndex.cs" />
		<Compile Include="../modules/Tuf/TufChartInfo.cs" Link="Source/TufChartInfo.cs" />
		<Compile Include="../modules/Tuf/TufCredits.cs" Link="Source/TufCredits.cs" />
		<Compile Include="../modules/Tuf/TufPackModels.cs" Link="Source/TufPackModels.cs" />
		<Compile Include="../modules/Tuf/TufPackApiClient.cs" Link="Source/TufPackApiClient.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Same embedded FAQ the mod ships, so FaqDocument.Default resolves in the
		     test assembly too. Logical name matches the main csproj. -->
		<EmbeddedResource Include="../Quartz/Resource/Export/FAQ.json">
			<LogicalName>Quartz.FAQ.Default.json</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
</Project>
