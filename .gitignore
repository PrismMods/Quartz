# Build output
bin/
obj/
/dist/
# The addon SDK reference assembly. Emitted by the mod build (PublishAddonSdk)
# with a fresh MVID every time, so tracking it made the tree dirty after any
# build. Modders get it from the release instead — tools/release.sh attaches it
# to every release, including the rolling latest-alpha pointer.
/sdk/QuartzAddon.dll
# Roslyn compiler artifacts leaked to repo root by the addon system's C# compiler
/Microsoft.CodeAnalysis.*

# IDE / editor
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.swp
*.swo
*~

# Local machine config (per-developer GamePath — use Directory.Build.example.props as template)
Directory.Build.props

# Per-developer reference assemblies standing in for whatever the game install
# lacks. Other people's binaries — never committed.
/lib/*

# OS
.DS_Store
Thumbs.db

# Misc
*.cache
*.log

.claude
.mcp.json
CLAUDE.md
.claude-flow
AGENTS.md
.agents
.codex
