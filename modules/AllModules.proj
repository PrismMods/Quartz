<Project>

	<!-- Traversal project: `dotnet build modules/AllModules.proj -c Release`
	     builds every module in modules/*/. tools/release.sh calls this once.
	     Deliberately not an SDK project — it produces no assembly of its own. -->

	<ItemGroup>
		<ModuleProject Include="$(MSBuildThisFileDirectory)*/*.csproj" />
	</ItemGroup>

	<Target Name="Build">
		<Message Importance="high" Text="Building @(ModuleProject->Count()) Quartz module(s)" />
		<MSBuild Projects="@(ModuleProject)" Targets="Build" Properties="Configuration=$(Configuration)" BuildInParallel="true" />
	</Target>

	<Target Name="Rebuild" DependsOnTargets="Clean;Build" />

	<Target Name="Clean">
		<MSBuild Projects="@(ModuleProject)" Targets="Clean" Properties="Configuration=$(Configuration)" />
	</Target>

	<Target Name="Restore">
		<MSBuild Projects="@(ModuleProject)" Targets="Restore" Properties="Configuration=$(Configuration)" />
	</Target>

</Project>
